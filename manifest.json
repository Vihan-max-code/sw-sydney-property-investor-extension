{
  "manifest_version": 3,
  "name": "SW Sydney Property Investor",
  "version": "3.0.0",
  "description": "AI-powered property investment analysis. Pulls live data from your backend API for any suburb.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.domain.com.au/*",
    "https://www.realestate.com.au/*",
    "https://www.allhomes.com.au/*",
    "http://localhost:3001/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.domain.com.au/*",
        "https://www.realestate.com.au/*",
        "https://www.allhomes.com.au/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
